    <TextView
        android:id="@+id/sub_view"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:background="@color/black"
        android:layout_gravity="center"
        />

</FrameLayout>

</com.dawn.zgstep.ui.ctm.views.DragFrameLayout>